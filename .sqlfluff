[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 120

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Disable column order rule — dbt models intentionally order
# columns by category (keys, dimensions, metrics, metadata)
# not by wildcard-first which sqlfluff expects
[sqlfluff:rules:structure.column_order]
force_enable = false

# Disable operator position rule — dbt community style uses
# trailing operators in CASE WHEN statements
[sqlfluff:rules:layout.operators]
force_enable = false