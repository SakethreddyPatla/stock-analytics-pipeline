[sqlfluff]
dialect = bigquery
# Use jinja templater in CI instead of dbt templater
# The dbt templater requires a live BigQuery connection to compile
# The jinja templater lints SQL syntax without needing credentials
# This is the standard approach for CI environments
templater = jinja
max_line_length = 120

[sqlfluff:templater:jinja]
# Tell jinja to ignore unresolved dbt macros like ref(), source(), config()
# These are dbt-specific functions that jinja doesn't know about
# Without this, sqlfluff would error on every {{ ref('model') }} call
apply_dbt_builtins = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit